<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_new_chat_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.new.chat.form</field>
        <field name="model">elblasy.waha.new.chat</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="account_id" options="{'no_create': True}"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="phone" placeholder="+20 100 123 4567"/>
                    <field name="message" placeholder="Optional first message"/>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Open chat" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="waha_new_chat_action" model="ir.actions.act_window">
        <field name="name">New WhatsApp chat</field>
        <field name="res_model">elblasy.waha.new.chat</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_waha_new_chat" name="New Chat (Discuss)" parent="elblasy_waha_connector.menu_waha_root"
              action="waha_new_chat_action" sequence="15" groups="whatsapp.group_whatsapp_admin,elblasy_waha_connector.group_waha_user"/>

    <record id="res_partner_view_form_waha_chat" model="ir.ui.view">
        <field name="name">res.partner.form.waha.chat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_waha_discuss_chat" type="object" class="oe_stat_button" icon="forum"
                        string="WhatsApp Chat" groups="elblasy_waha_connector.group_waha_user"/>
            </div>
        </field>
    </record>
</odoo>
