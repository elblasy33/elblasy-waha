<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_composer_view_form_waha" model="ir.ui.view">
        <field name="name">whatsapp.composer.form.waha</field>
        <field name="model">whatsapp.composer</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_composer_view_form"/>
        <field name="arch" type="xml">
            <field name="wa_template_id" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="placeholder">Optional: leave empty to write a free message</attribute>
            </field>
            <field name="wa_template_id" position="after">
                <field name="waha_free_text" invisible="1"/>
                <field name="waha_account_id" invisible="not waha_free_text" required="waha_free_text"
                       options="{'no_create': True, 'no_open': True}"/>
            </field>
            <field name="phone" position="after">
                <field name="waha_message" invisible="not waha_free_text" required="waha_free_text"
                       placeholder="Write your message..."/>
            </field>
        </field>
    </record>
</odoo>
