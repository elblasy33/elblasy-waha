<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elblasy_waha_connector.Inbox">
        <div class="o_waha_inbox" t-ref="this.rootRef"
             t-att-class="{ 'o_waha_has_current': this.state.current, 'o_waha_rtl': this.state.uiRtl }">
            <!-- ============================================================ chat list -->
            <div class="o_waha_list">
                <div class="o_waha_list_header">
                    <span class="o_waha_brand"><i class="oi me-2" data-icon="oi_whatsapp"/>Chats</span>
                    <select t-if="this.state.sessions.length > 1" class="form-select form-select-sm o_waha_session_select"
                            t-on-change="this.onSessionChange" title="WhatsApp number">
                        <option value="0">All numbers</option>
                        <option t-foreach="this.state.sessions" t-as="s" t-key="s.id" t-att-value="s.id" t-out="s.name"/>
                    </select>
                </div>
                <div class="o_waha_search">
                    <i class="oi" data-icon="search"/>
                    <input type="search" placeholder="Search or start a new chat" t-on-input="this.onSearchInput"/>
                </div>
                <div class="o_waha_chips">
                    <button class="o_waha_chip" t-att-class="{ active: this.isFilter('all') }" t-on-click="() => this.setFilter('all')">All</button>
                    <button class="o_waha_chip" t-att-class="{ active: this.isFilter('unread') }" t-on-click="() => this.setFilter('unread')">Unread</button>
                    <button class="o_waha_chip" t-att-class="{ active: this.isFilter('groups') }" t-on-click="() => this.setFilter('groups')">
                        <i class="oi me-1" data-icon="group"/>Groups
                    </button>
                    <button t-foreach="this.state.labels" t-as="l" t-key="l.id" class="o_waha_chip"
                            t-att-class="{ active: this.isFilter('label', l.id) }" t-on-click="() => this.setFilter('label', l.id)">
                        <span class="o_waha_chip_dot" t-att-style="'background-color:' + l.color"/>
                        <t t-out="l.name"/>
                    </button>
                </div>
                <div class="o_waha_conv_list">
                    <div t-if="this.state.filter === 'archived'" class="o_waha_archived_row" t-on-click="() => this.setFilter('all')">
                        <i class="oi" data-icon="arrow_back"/><span>Archived</span>
                    </div>
                    <div t-elif="this.state.archivedCount and this.state.filter === 'all'" class="o_waha_archived_row"
                         t-on-click="() => this.setFilter('archived')">
                        <i class="oi" data-icon="archive"/><span>Archived</span>
                        <span class="o_waha_archived_count" t-out="this.state.archivedCount"/>
                    </div>
                    <div t-foreach="this.state.conversations" t-as="c" t-key="c.id" class="o_waha_conv"
                         t-att-class="{ active: this.state.current and this.state.current.id === c.id }"
                         t-on-click="() => this.openConversation(c)">
                        <img t-if="c.has_image" class="o_waha_avatar" alt=""
                             t-att-src="'/web/image/elblasy.waha.conversation/' + c.id + '/image_128?unique=' + c.image_ts"/>
                        <span t-elif="c.is_group" class="o_waha_avatar o_waha_avatar_initials o_waha_avatar_group"><i class="oi" data-icon="group"/></span>
                        <span t-else="" class="o_waha_avatar o_waha_avatar_initials" t-att-style="'background-color:' + this.avatarColor(c.id)"
                              t-out="this.initials(c.name)"/>
                        <div class="o_waha_conv_body">
                            <div class="o_waha_conv_top">
                                <span class="o_waha_conv_name">
                                    <span dir="auto" t-out="this.displayName(c)"/><t t-if="c.is_me"> (You)</t>
                                </span>
                                <span class="o_waha_conv_time" t-att-class="{ o_waha_unread_time: c.unread }" t-out="this.listDate(c.last_date)"/>
                            </div>
                            <div class="o_waha_conv_bottom">
                                <span class="o_waha_conv_preview" dir="auto">
                                    <i t-if="c.last_direction === 'out' and !c.last_revoked" t-att-class="this.tickClass(c.last_status)" t-att-data-icon="this.tickIcon(c.last_status)"/>
                                    <t t-set="pv" t-value="this.preview(c)"/>
                                    <t t-if="c.is_group and c.last_author"><span dir="auto" t-out="c.last_author"/>: </t>
                                    <i t-if="pv.icon" class="oi me-1" t-att-data-icon="pv.icon"/>
                                    <t t-out="pv.text"/>
                                </span>
                                <i t-if="c.muted" class="oi o_waha_list_icon" data-icon="volume_off" title="Muted"/>
                                <span t-if="c.unread" class="o_waha_unread_badge" t-out="c.unread"/>
                                <i t-if="c.pinned" class="oi o_waha_list_icon" data-icon="push_pin" title="Pinned"/>
                                <i t-if="c.session_status !== 'WORKING'" class="oi text-warning ms-1" data-icon="link_off" title="Session offline"/>
                            </div>
                            <div t-if="c.labels.length" class="o_waha_conv_labels">
                                <span t-foreach="c.labels" t-as="l" t-key="l.id" class="o_waha_label"
                                      t-att-style="'background-color:' + l.color" t-out="l.name"/>
                            </div>
                        </div>
                    </div>
                    <div t-if="!this.state.conversations.length" class="o_waha_empty_list">No chats found.</div>
                </div>
            </div>

            <!-- ============================================================ thread -->
            <div class="o_waha_thread">
                <t t-if="this.state.current">
                    <t t-set="cur" t-value="this.state.current"/>
                    <div class="o_waha_thread_header">
                        <button class="btn btn-link o_waha_back" t-on-click="this.closeConversation" title="Back">
                            <i class="oi" data-icon="arrow_back"/>
                        </button>
                        <img t-if="cur.has_image" class="o_waha_avatar" alt=""
                             t-att-src="'/web/image/elblasy.waha.conversation/' + cur.id + '/image_128?unique=' + cur.image_ts"/>
                        <span t-elif="cur.is_group" class="o_waha_avatar o_waha_avatar_initials o_waha_avatar_group"><i class="oi" data-icon="group"/></span>
                        <span t-else="" class="o_waha_avatar o_waha_avatar_initials" t-att-style="'background-color:' + this.avatarColor(cur.id)"
                              t-out="this.initials(cur.name)"/>
                        <div class="o_waha_thread_title">
                            <div class="o_waha_conv_name"><span dir="auto" t-out="this.displayName(cur)"/><t t-if="cur.is_me"> (You)</t></div>
                            <div class="o_waha_thread_sub">
                                <t t-if="this.sessionDisconnected"><i class="oi text-warning" data-icon="link_off"/> WhatsApp number offline</t>
                                <t t-elif="cur.is_group">Group</t>
                                <span t-elif="cur.phone and this.displayName(cur) !== '+' + cur.phone" dir="ltr" t-out="'+' + cur.phone"/>
                                <t t-if="this.state.sessions.length > 1"> · <t t-out="cur.session_name"/></t>
                            </div>
                        </div>
                        <div class="o_waha_thread_actions">
                            <div class="position-relative d-inline-block">
                                <button t-if="this.currentSessionLabels.length" class="btn o_waha_icon_btn" title="Labels" t-on-click="this.toggleLabelsMenu">
                                    <i class="oi" data-icon="label"/>
                                </button>
                                <div t-if="this.state.labelsOpen" class="o_waha_labels_menu">
                                    <div t-foreach="this.currentSessionLabels" t-as="l" t-key="l.id" class="o_waha_label_option"
                                         t-on-click="() => this.toggleLabel(l)">
                                        <i class="oi me-2" t-att-data-icon="this.isLabelOn(l) ? 'check_box' : 'square'"/>
                                        <span class="o_waha_label" t-att-style="'background-color:' + l.color" t-out="l.name"/>
                                    </div>
                                </div>
                            </div>
                            <button t-if="cur.partner_id" class="btn o_waha_icon_btn" title="Open contact" t-on-click="this.openPartner">
                                <i class="oi" data-icon="contact_page"/>
                            </button>
                            <button t-else="" class="btn o_waha_icon_btn" title="Create contact" t-on-click="this.createPartner">
                                <i class="oi" data-icon="person_add"/>
                            </button>
                        </div>
                    </div>

                    <div t-if="this.pinned" class="o_waha_pinned_bar" t-on-click="() => this.scrollToMessage(this.pinned)">
                        <i class="oi" data-icon="push_pin"/>
                        <span class="text-truncate" dir="auto" t-out="this.pinned.body or this.pendingLabel(this.pinned)"/>
                    </div>
                    <div class="o_waha_messages" t-ref="this.threadRef" t-on-scroll="this.onThreadScroll">
                        <div t-if="this.state.hasMore or this.state.loadingOlder" class="text-center my-2">
                            <span class="o_waha_day"><i t-if="this.state.loadingOlder" class="oi oi-spin me-1" data-icon="progress_activity"/>Scroll up for older messages</span>
                        </div>
                        <t t-foreach="this.rows" t-as="row" t-key="row.key">
                            <div t-if="row.day" class="o_waha_day_row"><span class="o_waha_day" t-out="row.day"/></div>
                            <t t-else="">
                                <t t-set="m" t-value="row.message"/>
                                <div class="o_waha_row" t-att-class="{ o_waha_row_out: m.direction === 'out', o_waha_row_first: row.first }">
                                    <div class="o_waha_bubble" t-att-id="'o_waha_msg_' + m.id"
                                         t-att-class="{
                                            o_out: m.direction === 'out', o_in: m.direction === 'in', o_tail: row.first,
                                            o_waha_sticker_bubble: m.type === 'sticker' and !m.revoked,
                                            o_waha_media_bubble: this.isBareMedia(m) }">
                                        <button class="o_waha_msg_menu_btn" title="Menu" t-on-click="() => this.toggleMenu(m)">
                                            <i class="oi" data-icon="keyboard_arrow_down"/>
                                        </button>
                                        <div t-if="this.state.menuFor === m.id" class="o_waha_msg_menu"
                                             t-att-class="{ o_waha_menu_out: m.direction === 'out' }">
                                            <div t-if="m.remote and !m.revoked" class="o_waha_quick_reactions">
                                                <button t-foreach="this.quickReactions" t-as="emoji" t-key="emoji" t-on-click="() => this.react(m, emoji)"
                                                        t-out="emoji"/>
                                                <button class="o_waha_more_reactions" t-ref="this.reactRef" title="More reactions">
                                                    <i class="oi" data-icon="add"/>
                                                </button>
                                            </div>
                                            <div class="o_waha_menu_items">
                                                <button t-on-click="() => this.openDialog('info', m)"><i class="oi" data-icon="info"/>Message info</button>
                                                <t t-if="!m.revoked">
                                                    <button t-if="m.remote" class="o_waha_act_reply" t-on-click="() => this.startReply(m)"><i class="oi" data-icon="reply"/>Reply</button>
                                                    <button t-if="m.body" t-on-click="() => this.copyText(m)"><i class="oi" data-icon="content_copy"/>Copy</button>
                                                    <button t-if="m.editable" t-on-click="() => this.startEdit(m)"><i class="oi" data-icon="edit"/>Edit</button>
                                                    <button t-if="m.remote" t-on-click="() => this.openDialog('forward', m)"><i class="oi" data-icon="forward"/>Forward</button>
                                                    <button t-if="m.remote" t-on-click="() => this.togglePin(m)">
                                                        <i class="oi" data-icon="push_pin"/><t t-if="m.pinned">Unpin</t><t t-else="">Pin</t>
                                                    </button>
                                                    <button t-if="m.remote" t-on-click="() => this.toggleStar(m)">
                                                        <i class="oi" data-icon="star"/><t t-if="m.starred">Unstar</t><t t-else="">Star</t>
                                                    </button>
                                                    <button t-if="cur.partner_id" t-on-click="() => this.addNote(m)"><i class="oi" data-icon="sticky_note_2"/>Add to the contact's notes</button>
                                                </t>
                                                <div class="o_waha_menu_sep"/>
                                                <button class="o_waha_menu_danger" t-on-click="() => this.openDialog('delete', m)"><i class="oi" data-icon="delete"/>Delete</button>
                                            </div>
                                        </div>
                                        <div t-if="cur.is_group and m.direction === 'in' and row.first" class="o_waha_author"
                                             t-att-style="'color:' + this.authorColor(m.sender)">
                                            <span dir="auto" t-out="m.author or m.sender"/>
                                        </div>
                                        <div t-if="m.forwarded" class="o_waha_meta_line"><i class="oi me-1" data-icon="forward"/>Forwarded</div>
                                        <span t-if="m.revoked" class="o_waha_revoked" t-att-title="m.body"><span t-if="this.spaceAtStart(this.deletedLabel)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/><i class="oi me-1" data-icon="block"/><t t-out="this.deletedLabel"/><span t-if="!this.spaceAtStart(this.deletedLabel)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/></span>
                                        <t t-else="">
                                            <div t-if="m.quoted" class="o_waha_quote"><span dir="auto" t-out="m.quoted"/></div>
                                            <t t-foreach="m.attachments" t-as="a" t-key="a.id">
                                                <t t-set="kind" t-value="this.kindOf(a)"/>
                                                <a t-if="kind === 'image'" t-att-href="'/web/content/' + a.id" target="_blank" class="o_waha_media_link">
                                                    <img t-att-class="m.type === 'sticker' ? 'o_waha_sticker' : 'o_waha_img'"
                                                         t-att-src="'/web/image/' + a.id" t-att-alt="a.name" loading="lazy"/>
                                                </a>
                                                <video t-elif="kind === 'video'" class="o_waha_video" controls="controls" preload="metadata"
                                                       t-att-src="'/web/content/' + a.id"/>
                                                <audio t-elif="kind === 'audio'" class="o_waha_audio" controls="controls" preload="none"
                                                       t-att-src="'/web/content/' + a.id"/>
                                                <a t-else="" class="o_waha_doc" t-att-href="'/web/content/' + a.id + '?download=true'">
                                                    <i t-attf-class="oi o_waha_doc_icon {{ this.fileIcon(a.name)[1] }}" t-att-data-icon="this.fileIcon(a.name)[0]"/>
                                                    <span class="o_waha_doc_info">
                                                        <span class="o_waha_doc_name" t-out="a.name"/>
                                                        <span class="o_waha_doc_meta">
                                                            <t t-out="this.fileExt(a.name)"/>
                                                            <t t-if="a.size"> · <t t-out="this.fileSize(a.size)"/></t>
                                                        </span>
                                                    </span>
                                                    <i class="oi o_waha_doc_dl" data-icon="download"/>
                                                </a>
                                            </t>
                                            <button t-if="this.isMediaWithoutFile(m)" class="o_waha_pending"
                                                    t-on-click="() => this.downloadMedia(m)" t-att-disabled="this.state.downloading[m.id]">
                                                <i class="oi o_waha_pending_type" t-att-data-icon="this.pendingIcon(m)"/>
                                                <span class="o_waha_doc_info">
                                                    <span class="o_waha_doc_name" t-out="this.pendingLabel(m)"/>
                                                    <span class="o_waha_doc_meta">Kept on WhatsApp · click to download</span>
                                                </span>
                                                <i class="oi o_waha_doc_dl" t-att-class="{ 'oi-spin': this.state.downloading[m.id] }"
                                                   t-att-data-icon="this.state.downloading[m.id] ? 'progress_activity' : 'download'"/>
                                            </button>
                                            <a t-if="m.type === 'location' and m.location" class="o_waha_location" t-att-href="this.mapUrl(m)"
                                               target="_blank" rel="noopener noreferrer">
                                                <i class="oi" data-icon="location_on"/>
                                                <span dir="auto" t-out="m.body or 'Location'"/>
                                            </a>
                                            <div t-elif="m.type === 'contact'" class="o_waha_vcard">
                                                <i class="oi" data-icon="account_circle"/>
                                                <span dir="auto" t-out="m.body or 'Contact'"/>
                                            </div>
                                            <div t-elif="m.type === 'poll'" class="o_waha_poll">
                                                <div class="o_waha_meta_line"><i class="oi me-1" data-icon="bar_chart"/>Poll</div>
                                                <div class="o_waha_poll_text" dir="auto" t-out="m.body"/>
                                            </div>
                                            <span t-elif="m.body" class="o_waha_text" dir="auto"><span t-if="this.spaceAtStart(m.body)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/><t t-out="this.bodyHtml(m)"/><button t-if="this.isLong(m)" class="o_waha_read_more" t-on-click="() => this.expand(m)">Read more</button><span t-if="!this.spaceAtStart(m.body)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/></span>
                                            <span t-elif="!m.attachments.length and !this.isMediaWithoutFile(m)" class="o_waha_text o_waha_unsupported"><span t-if="this.spaceAtStart(this.unsupportedLabel)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/><t t-out="this.unsupportedLabel"/><span t-if="!this.spaceAtStart(this.unsupportedLabel)" class="o_waha_space" t-att-style="this.spaceStyle(m)"/></span>
                                        </t>
                                        <div t-if="this.needsMetaLine(m)" class="o_waha_meta_space"/>
                                        <span class="o_waha_meta">
                                            <i t-if="m.starred" class="oi me-1" data-icon="star" title="Starred"/>
                                            <i t-if="m.pinned" class="oi me-1" data-icon="push_pin" title="Pinned"/>
                                            <span t-if="m.edited" class="me-1">Edited</span>
                                            <i t-if="m.is_auto" class="oi me-1" data-icon="autorenew" title="Automatic reply"/>
                                            <span t-att-title="m.sender" t-out="this.timeOf(m.date)"/>
                                            <i t-if="m.direction === 'out'" t-att-class="this.tickClass(m.status)" t-att-data-icon="this.tickIcon(m.status)"
                                               t-att-title="m.failure or this.tickTitle(m.status)"/>
                                        </span>
                                        <div t-if="m.failure and m.status === 'failed'" class="o_waha_failure" t-out="m.failure"/>
                                        <div t-if="m.reactions.length" class="o_waha_reactions">
                                            <span t-foreach="m.reactions" t-as="r" t-key="r.emoji" t-att-class="{ o_waha_mine: r.mine }">
                                                <t t-out="r.emoji"/><t t-if="r.count > 1" t-out="r.count"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>

                    <div t-if="this.sessionDisconnected" class="o_waha_offline">
                        <i class="oi me-1" data-icon="link_off"/>The WhatsApp number is not connected. Messages cannot be sent.
                    </div>
                    <div t-if="this.state.replyTo or this.state.editing" class="o_waha_composer_bar">
                        <t t-set="target" t-value="this.state.replyTo or this.state.editing"/>
                        <div class="o_waha_composer_quote">
                            <div class="o_waha_composer_quote_title">
                                <t t-if="this.state.editing">Edit message</t>
                                <t t-elif="target.direction === 'out'">Reply to yourself</t>
                                <t t-else="">Reply to <t t-out="target.author or this.displayName(cur)"/></t>
                            </div>
                            <div class="text-truncate" dir="auto" t-out="target.body or this.pendingLabel(target)"/>
                        </div>
                        <button class="btn o_waha_icon_btn" title="Cancel" t-on-click="this.cancelComposerMode"><i class="oi" data-icon="close"/></button>
                    </div>
                    <div class="o_waha_composer">
                        <input type="file" class="d-none" t-ref="this.fileRef" t-on-change="this.onFileChange"/>
                        <button class="btn o_waha_icon_btn" title="Emoji" t-ref="this.emojiRef" t-att-disabled="this.sessionDisconnected">
                            <i class="oi" data-icon="sentiment_satisfied"/>
                        </button>
                        <button class="btn o_waha_icon_btn" title="Attach" t-att-disabled="this.state.sending or this.sessionDisconnected"
                                t-on-click="this.onAttachClick">
                            <i class="oi" data-icon="attach_file"/>
                        </button>
                        <textarea class="o_waha_input" rows="1" placeholder="Type a message" t-ref="this.composerRef"
                                  t-att-value="this.state.draft" t-on-input="this.onDraftInput" t-on-keydown="this.onDraftKeydown"
                                  t-att-disabled="this.sessionDisconnected"/>
                        <button class="btn o_waha_send" title="Send" t-on-click="this.send"
                                t-att-disabled="this.state.sending or this.sessionDisconnected or !this.state.draft.trim()">
                            <i class="oi" t-att-class="{ 'oi-spin': this.state.sending }" t-att-data-icon="this.state.sending ? 'progress_activity' : 'send'"/>
                        </button>
                    </div>
                    <div t-if="this.state.dialog" class="o_waha_modal" t-on-click.self="this.closeDialog">
                        <t t-set="dm" t-value="this.state.dialog.message"/>
                        <div class="o_waha_modal_box">
                            <t t-if="this.state.dialog.kind === 'delete'">
                                <h5>Delete message?</h5>
                                <p class="text-muted small">"Delete for me" only hides it in Odoo (reports keep it).</p>
                                <div class="d-flex flex-column gap-2">
                                    <button t-if="dm.direction === 'out' and dm.remote and !dm.revoked" class="btn btn-danger"
                                            t-on-click="() => this.deleteMessage('everyone')">Delete for everyone</button>
                                    <button class="btn btn-outline-danger" t-on-click="() => this.deleteMessage('me')">Delete for me</button>
                                    <button class="btn btn-secondary" t-on-click="this.closeDialog">Cancel</button>
                                </div>
                            </t>
                            <t t-elif="this.state.dialog.kind === 'forward'">
                                <h5>Forward message to</h5>
                                <input class="form-control mb-2" type="search" placeholder="Search…"
                                       t-on-input="(ev) => this.state.forwardSearch = ev.target.value"/>
                                <div class="o_waha_forward_list">
                                    <label t-foreach="this.forwardTargets" t-as="fc" t-key="fc.id" class="o_waha_forward_item">
                                        <input type="checkbox" t-att-checked="this.state.forwardIds.includes(fc.id)" t-on-change="() => this.toggleForward(fc)"/>
                                        <span dir="auto" t-out="this.displayName(fc)"/>
                                    </label>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted"><t t-out="this.state.forwardIds.length"/> / 5</small>
                                    <div>
                                        <button class="btn btn-secondary me-2" t-on-click="this.closeDialog">Cancel</button>
                                        <button class="btn btn-primary" t-att-disabled="!this.state.forwardIds.length" t-on-click="this.forward">
                                            <i class="oi me-1" data-icon="send"/>Forward
                                        </button>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <h5>Message info</h5>
                                <table class="table table-sm mb-3">
                                    <tr><th>Date</th><td t-out="this.fullDate(dm.date)"/></tr>
                                    <tr><th>Direction</th><td><t t-if="dm.direction === 'out'">Sent</t><t t-else="">Received</t></td></tr>
                                    <tr t-if="dm.direction === 'out'"><th>Status</th><td t-out="this.statusText(dm)"/></tr>
                                    <tr t-if="dm.user"><th>Sent by</th><td t-out="dm.user"/></tr>
                                    <tr t-if="dm.is_auto"><th>Automatic</th><td>Yes</td></tr>
                                    <tr t-if="dm.author"><th>Group member</th><td dir="auto" t-out="dm.author"/></tr>
                                    <tr t-if="dm.failure"><th>Error</th><td class="text-danger" t-out="dm.failure"/></tr>
                                </table>
                                <div class="text-end"><button class="btn btn-secondary" t-on-click="this.closeDialog">Close</button></div>
                            </t>
                        </div>
                    </div>
                </t>
                <div t-else="" class="o_waha_welcome">
                    <div class="o_waha_welcome_icon"><i class="oi" data-icon="oi_whatsapp"/></div>
                    <h3>Elblasy WhatsApp</h3>
                    <p>Send and receive WhatsApp messages from Odoo.<br/>Select a chat to start.</p>
                    <small><i class="oi me-1" data-icon="lock"/>Messages go through your own WAHA server.</small>
                </div>
            </div>
        </div>
    </t>
</templates>
