<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_waha" model="res.groups.privilege">
        <field name="name">WhatsApp (WAHA)</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_waha_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_waha"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_waha_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_waha"/>
        <field name="implied_ids" eval="[(4, ref('group_waha_user'))]"/>
    </record>
    <record id="group_waha_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_waha"/>
        <field name="implied_ids" eval="[(4, ref('group_waha_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
