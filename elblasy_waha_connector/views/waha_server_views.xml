<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_server_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.server.list</field>
        <field name="model">elblasy.waha.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_url"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_test_result"/>
            </list>
        </field>
    </record>
    <record id="waha_server_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.server.form</field>
        <field name="model">elblasy.waha.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"
                            groups="elblasy_waha_connector.group_waha_manager"/>
                </header>
                <sheet>
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="base_url" placeholder="https://waha.example.com"/>
                            <field name="api_key" password="True" groups="elblasy_waha_connector.group_waha_manager"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Network">
                            <field name="timeout_connect"/>
                            <field name="timeout_read"/>
                            <field name="verify_ssl"/>
                        </group>
                        <group string="Webhook">
                            <field name="webhook_base_url" placeholder="https://odoo.example.com"/>
                            <field name="use_hmac"/>
                            <field name="webhook_secret" password="True" invisible="not use_hmac"
                                   groups="elblasy_waha_connector.group_waha_manager"/>
                        </group>
                        <group string="Last test">
                            <field name="last_test_date"/>
                            <field name="last_test_result"/>
                        </group>
                    </group>
                    <field name="session_ids" mode="list">
                        <list><field name="name"/><field name="session_name"/><field name="status"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="waha_server_action" model="ir.actions.act_window">
        <field name="name">WAHA Servers</field>
        <field name="res_model">elblasy.waha.server</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
