<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_group_send_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.group.send.form</field>
        <field name="model">elblasy.waha.group.send</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="res_model" invisible="1"/><field name="res_id" invisible="1"/><field name="token" invisible="1"/>
                    <field name="allowed_group_ids" invisible="1"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="send_to_customer"/>
                    <field name="phone" invisible="not send_to_customer" required="send_to_customer"/>
                    <field name="session_id" invisible="not send_to_customer" required="send_to_customer"
                           options="{'no_create': True}"/>
                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="report_id" invisible="not res_model" options="{'no_create': True}"/>
                    <field name="body" placeholder="Message"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="waha_group_send_action" model="ir.actions.act_window">
        <field name="name">Send to WhatsApp group</field>
        <field name="res_model">elblasy.waha.group.send</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
