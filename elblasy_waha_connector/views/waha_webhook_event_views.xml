<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_webhook_event_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.webhook.event.list</field>
        <field name="model">elblasy.waha.webhook.event</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'">
                <field name="create_date"/><field name="session_id"/><field name="event_type"/>
                <field name="state"/><field name="attempts"/><field name="error"/>
            </list>
        </field>
    </record>
    <record id="waha_webhook_event_action" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">elblasy.waha.webhook.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
