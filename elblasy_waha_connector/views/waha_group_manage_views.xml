<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_group_create_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.group.create.form</field>
        <field name="model">elblasy.waha.group.create</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="session_id" options="{'no_create': True}"/>
                    <field name="name"/>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="link_to_partners"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create group" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="waha_group_create_action" model="ir.actions.act_window">
        <field name="name">Create WhatsApp group</field>
        <field name="res_model">elblasy.waha.group.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="waha_group_members_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.group.members.form</field>
        <field name="model">elblasy.waha.group.members</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="group_id" invisible="1"/>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="waha_group_message_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.group.message.list</field>
        <field name="model">elblasy.waha.group.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/><field name="sender_name"/><field name="sender_id" optional="hide"/>
                <field name="body"/><field name="from_me" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
