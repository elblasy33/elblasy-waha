<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ dashboard (last item of Reporting) -->
    <record id="waha_dashboard_action" model="ir.actions.client">
        <field name="name">WhatsApp Dashboard</field>
        <field name="tag">elblasy_waha_dashboard</field>
    </record>

    <!-- ============================================================ tracked documents (configuration) -->
    <record id="waha_tracked_model_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.tracked.model.list</field>
        <field name="model">elblasy.waha.tracked.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="date_field_id"/>
                <field name="amount_field_id"/>
                <field name="window_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="waha_tracked_model_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.tracked.model.form</field>
        <field name="model">elblasy.waha.tracked.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Confirmed sales orders"/></h1></div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="date_field_id" options="{'no_create': True}" invisible="not model_id"/>
                            <field name="partner_field_id" options="{'no_create': True}" invisible="not model_id"/>
                            <field name="amount_field_id" options="{'no_create': True}" invisible="not model_id"/>
                        </group>
                        <group>
                            <field name="window_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <label for="domain" invisible="not model"/>
                    <field name="domain" widget="domain" options="{'model': 'model'}" invisible="not model"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="waha_tracked_model_action" model="ir.actions.act_window">
        <field name="name">Tracked Documents</field>
        <field name="res_model">elblasy.waha.tracked.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Measure any document against WhatsApp</p>
            <p>Quotations, invoices, opportunities, tickets, repairs, rentals... any model with a date and a customer.</p></field>
    </record>

    <!-- ============================================================ sent documents -->
    <record id="waha_report_document_view_search" model="ir.ui.view">
        <field name="name">elblasy.waha.report.document.search</field>
        <field name="model">elblasy.waha.report.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="partner_id" operator="child_of"/>
                <field name="phone" filter_domain="[('phone', 'ilike', self)]"/>
                <field name="template"/>
                <field name="user_id"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="customers" string="To customers" domain="[('channel', '=', 'customer')]"/>
                <filter name="groups" string="To groups" domain="[('channel', '=', 'group')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_model" string="Document type" context="{'group_by': 'model_id'}"/>
                    <filter name="g_template" string="Template" context="{'group_by': 'template'}"/>
                    <filter name="g_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_user" string="Sent by" context="{'group_by': 'user_id'}"/>
                    <filter name="g_source" string="Sent from" context="{'group_by': 'source'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="waha_report_document_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.report.document.list</field>
        <field name="model">elblasy.waha.report.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'failed'">
                <field name="date"/>
                <field name="model_id"/>
                <field name="record_name"/>
                <field name="template" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="channel" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
                <field name="res_model" column_invisible="1"/>
                <button name="action_open_record" type="object" icon="open_in_new" title="Open the document"/>
            </list>
        </field>
    </record>
    <record id="waha_report_document_view_pivot" model="ir.ui.view">
        <field name="name">elblasy.waha.report.document.pivot</field>
        <field name="model">elblasy.waha.report.document</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="model_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="nbr" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="waha_report_document_action" model="ir.actions.act_window">
        <field name="name">Sent Documents</field>
        <field name="res_model">elblasy.waha.report.document</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_sent': 1}</field>
        <field name="help" type="html"><p>Every document sent on WhatsApp, from any app: "Send to WhatsApp", automations
            and Odoo WhatsApp templates.</p></field>
    </record>

    <!-- ============================================================ business impact -->
    <record id="waha_report_business_view_search" model="ir.ui.view">
        <field name="name">elblasy.waha.report.business.search</field>
        <field name="model">elblasy.waha.report.business</field>
        <field name="arch" type="xml">
            <search>
                <field name="tracked_model_id"/>
                <field name="partner_id" operator="child_of"/>
                <filter name="from_whatsapp" string="After a WhatsApp chat" domain="[('from_whatsapp', '=', True)]"/>
                <filter name="whatsapp_customer" string="WhatsApp customers" domain="[('whatsapp_customer', '=', True)]"/>
                <filter name="sent_on_whatsapp" string="Sent on WhatsApp" domain="[('sent_on_whatsapp', '=', True)]"/>
                <filter name="not_whatsapp" string="No WhatsApp contact" domain="[('whatsapp_customer', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_tracked" string="Document type" context="{'group_by': 'tracked_model_id'}"/>
                    <filter name="g_from" string="After WhatsApp" context="{'group_by': 'from_whatsapp'}"/>
                    <filter name="g_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="waha_report_business_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.report.business.list</field>
        <field name="model">elblasy.waha.report.business</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="from_whatsapp">
                <field name="date"/>
                <field name="tracked_model_id"/>
                <field name="record_name"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="from_whatsapp"/>
                <field name="days_after_chat" optional="show"/>
                <field name="sent_on_whatsapp" optional="show"/>
                <field name="whatsapp_customer" optional="hide"/>
                <field name="res_model" column_invisible="1"/>
                <button name="action_open_record" type="object" icon="open_in_new" title="Open the document"/>
            </list>
        </field>
    </record>
    <record id="waha_report_business_view_pivot" model="ir.ui.view">
        <field name="name">elblasy.waha.report.business.pivot</field>
        <field name="model">elblasy.waha.report.business</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="tracked_model_id" type="row"/>
                <field name="from_whatsapp" type="col"/>
                <field name="nbr" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="waha_report_business_view_graph" model="ir.ui.view">
        <field name="name">elblasy.waha.report.business.graph</field>
        <field name="model">elblasy.waha.report.business</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="from_whatsapp"/>
                <field name="nbr" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="waha_report_business_action" model="ir.actions.act_window">
        <field name="name">Business from WhatsApp</field>
        <field name="res_model">elblasy.waha.report.business</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html"><p>Tracked documents (Configuration ▸ Tracked Documents) and whether their customer
            chatted on WhatsApp shortly before. Compare with "No WhatsApp contact" to see what WhatsApp brings.</p></field>
    </record>

    <menuitem id="menu_waha_report_documents" name="Sent Documents" parent="menu_waha_reporting"
              action="waha_report_document_action" sequence="50"/>
    <menuitem id="menu_waha_report_business" name="Business from WhatsApp" parent="menu_waha_reporting"
              action="waha_report_business_action" sequence="60"/>
    <menuitem id="menu_waha_dashboard" name="Dashboard" parent="menu_waha_reporting"
              action="waha_dashboard_action" sequence="99"/>
    <menuitem id="menu_waha_tracked_models" name="Tracked Documents" parent="menu_waha_config"
              action="waha_tracked_model_action" sequence="65" groups="group_waha_manager"/>
</odoo>
