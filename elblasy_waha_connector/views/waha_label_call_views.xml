<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_label_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.label.list</field>
        <field name="model">elblasy.waha.label</field>
        <field name="arch" type="xml">
            <list create="0"><field name="name"/><field name="color_hex" widget="color"/><field name="session_id"/></list>
        </field>
    </record>
    <record id="waha_label_action" model="ir.actions.act_window">
        <field name="name">Labels</field>
        <field name="res_model">elblasy.waha.label</field>
        <field name="view_mode">list</field>
    </record>
    <record id="waha_call_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.call.list</field>
        <field name="model">elblasy.waha.call</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/><field name="chat_id"/><field name="partner_id"/><field name="is_video"/>
                <field name="rejected"/><field name="replied"/><field name="session_id"/>
            </list>
        </field>
    </record>
    <record id="waha_call_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">elblasy.waha.call</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_waha_labels" name="Labels" parent="menu_waha_config" action="waha_label_action"
              sequence="80" groups="group_waha_manager"/>
    <menuitem id="menu_waha_calls" name="Calls" parent="menu_waha_reporting" action="waha_call_action" sequence="20"/>
</odoo>
