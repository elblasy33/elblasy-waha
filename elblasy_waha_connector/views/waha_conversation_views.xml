<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="waha_conversation_view_list" model="ir.ui.view">
        <field name="name">elblasy.waha.conversation.list</field>
        <field name="model">elblasy.waha.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="remote_phone"/><field name="partner_id"/>
                <field name="session_id"/><field name="last_message_date"/><field name="unread_count"/>
            </list>
        </field>
    </record>
    <record id="waha_conversation_view_form" model="ir.ui.view">
        <field name="name">elblasy.waha.conversation.form</field>
        <field name="model">elblasy.waha.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_partner" type="object" string="Create Contact" invisible="partner_id"/>
                    <button name="action_resolve_lid" type="object" string="Find phone number"
                            invisible="chat_type != 'lid' or remote_phone"/>
                </header>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar" invisible="not image_128"/>
                    <group>
                        <group>
                            <field name="name"/><field name="session_id"/><field name="partner_id"/>
                            <field name="label_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="remote_phone" readonly="id" placeholder="e.g. 201001234567"/>
                            <field name="remote_chat_id" readonly="id" placeholder="Filled from the phone"/>
                            <field name="chat_type"/>
                            <field name="display_name_remote"/><field name="active"/>
                        </group>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list><field name="date"/><field name="direction"/><field name="body"/><field name="delivery_status"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="waha_conversation_view_search" model="ir.ui.view">
        <field name="name">elblasy.waha.conversation.search</field>
        <field name="model">elblasy.waha.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="remote_phone"/><field name="partner_id"/>
                <filter name="unread" string="Unread" domain="[('unread_count', '>', 0)]"/>
                <group><filter name="by_session" string="Session" context="{'group_by': 'session_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="waha_conversation_action" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">elblasy.waha.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
